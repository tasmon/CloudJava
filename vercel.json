{
  "buildCommand": "node make-preload.js",
  "outputDirectory": ".",
  "functions": { "api/proxy.js": { "maxDuration": 30 } },
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    { "source": "/(.*)\\.(wasm|jar)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
    { "source": "/(.*)\\.(html|js|css|json)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
